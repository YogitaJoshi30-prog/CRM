{
  "name": "drisu-compliance-operations-portal",
  "version": "1.0.0",
  "description": "An End-to-End Client, Case, Document and Compliance Management Platform",
  "main": "server/src/server.js",
  "scripts": {
    "start": "node server/src/server.js",
    "server": "node server/src/server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "prisma:generate": "npx prisma@5.10.0 generate --schema=prisma/schema.prisma",
    "prisma:push": "npx prisma@5.10.0 db push --schema=prisma/schema.prisma",
    "use:sqlite": "node -e \"require('fs').copyFileSync('prisma/schema.sqlite.prisma', 'prisma/schema.prisma')\" && npx prisma@5.10.0 generate",
    "prisma:seed": "node prisma/seed.js",
    "seed": "node prisma/seed.js",
    "test": "node --test server/tests/api.test.js"
  },
  "keywords": [
    "compliance",
    "operations",
    "portal",
    "express",
    "react",
    "prisma",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prisma": "^5.10.0"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^3.0.3"
  }
}
